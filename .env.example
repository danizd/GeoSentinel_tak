# GeoSentinel_tak — plantilla de secretos para docker-compose.yml
# Copia a .env y rellena con valores largos y aleatorios. NUNCA hagas commit de .env.
#   cp .env.example .env && python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bearer token que la UI usa contra la API del core
FTS_API_TOKEN=cambia-esto

# Contraseña de los certificados de cliente que FTS genera (enrolamiento 8089)
FTS_CLIENT_CERT_PASSWORD=cambia-esto

# Contraseña de federación FTS
FTS_FED_PASSWORD=cambia-esto

# Secret key del core (sesiones/firmas)
FTS_SECRET_KEY=cambia-esto

# Clave del WebSocket que comparten core y UI
FTS_WEBSOCKET_KEY=cambia-esto
